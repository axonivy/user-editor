pipeline {
  agent any

  options {
    buildDiscarder(logRotator(numToKeepStr: '30', artifactNumToKeepStr: '5'))
  }

  triggers {
    cron '@midnight'
  }

  stages {
    stage('sonar') {
      agent {
        docker {
          image 'sonarsource/sonar-scanner-cli'          
        }
      }
      steps {
        script {
          withSonarQubeEnv() {
            sh '''              
              npx sonar-scanner \
                -Dsonar.projectKey=user-editor \
                -Dsonar.projectName=user-editor \
                -Dsonar.sources=packages \
                -Dsonar.tests=playwright,integrations \
                -Dsonar.exclusions=node_modules/**
              '''
          }
          timeout(time: 5, unit: 'MINUTES') {
            def qg = waitForQualityGate abortPipeline: false
            if (qg.status != 'OK') {
              //unstable("SonarQube Quality Gate failed: ${qg.status}")
            }    
          }            
        }
      }
    }   
  } 
}
